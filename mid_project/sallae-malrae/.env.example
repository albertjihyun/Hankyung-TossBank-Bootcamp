# 살래말래 환경변수 템플릿
# 실제 값은 .env.local 파일을 만들어 입력하세요. (.env.local은 .gitignore 처리됨)

# MariaDB 접속 문자열 (예: mysql://user:password@localhost:3306/sallae_malrae)
DATABASE_URL=

# JWT 서명 키 (생성: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 이메일 알림 발송용 SMTP 계정
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# 서비스 외부 URL (이메일 링크, 공유 URL 생성에 사용)
NEXT_PUBLIC_API_URL=

# 이미지 업로드용 GCS 버킷 이름
GCS_BUCKET_NAME=
